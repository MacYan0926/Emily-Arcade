{
  "id": "./",
  "name": "Emily's Strange Arcade",
  "short_name": "Emily Arcade",
  "description": "A personal Emily the Strange fan-made arcade for original web games.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
